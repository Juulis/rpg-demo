  "meta": {
    "version": "2.0",
    "model": "D2 spawn: alla monster i ett område slumpas EN gång per game när området laddas och återkommer inte efter att de dödats. Inga respawntider.",
    "units": "Startskogen i världsenheter från game.js. Städer i rutor från respektive layout.",
    "seed_rule": {
      "new_game": "Nytt game (ny start eller laddning från menyn) skapar game_seed = slumpat 32 bitars heltal.",
      "same_game": "Inom samma game används samma seed. Områdets frö = hash(game_seed, area_id), punktens frö = hash(game_seed, area_id, point_id), så resultatet blir identiskt även om området laddas om.",
      "game_state": "Varje genererat monster får ett id (area_id:point_id:grupp:index). Döda id:n sparas i game_state.dead_monsters och hoppas över vid omladdning. Skadade monster behåller inte HP mellan omladdningar (återställs).",
      "persistent": "Stadstillstånd, lorebok, hjälte och föremål sparas mellan games; monster gör det inte."
    },
    "state_rule": "Endast besatt genererar monster. rensad och aterbefolkad_1 till 3 stänger spawn permanent i alla games, inklusive utkant. Bossen genereras bara om den inte är besegrad i sparfilen (besegrad boss ger rensad stad när alla zoner är rensade).",
    "group_rule": "Varje grupp väljer undertyp viktat ur punktens enemy_table (eller zonens tabell). escort lägger till följeslagare.",
    "level_rule": "Spawnpunkter väljer undertyp (subtypes och enemy_table på punkten, annars zone_tables eller områdets enemy_table). Monstrets nivå och stats är undertypens fasta värden. level_range_derived är bara information.",
    "elite_rule": "Se session_roll.champions och session_roll.uniques.",
    "elites_ref": "monster_niva.json elites",
    "removed": "Respawntider, max_alive, max_alive_area, state_spawn_multiplier, outskirts och runes_scaling är borttagna i version 2.0.",
    "session_roll_rule": "session_roll per område: 1) välj antal aktiva spawnpunkter inom active_spawn_points (always_active ingår alltid), 2) per aktiv punkt antal grupper inom groups, 3) per grupp storlek inom radens group eller punktens group_size (monsters_per_group som standard), 4) champion per grupp med chance_per_group tills max nåtts, 5) unika med chance_per_game, högst max.",
    "design_rule": "Inga inträdeskrav. recommended_hero_level är ren information.",
    "mixed_spawn_enabled": false,
    "mixed_spawn_enabled_after": "grafik_2d",
    "mixed_rule": "Tills grafik_2d är klar används enemy_table (huvudfamilj). När flaggan slås på används family_mix.enemy_table_mixed och mixed_groups, viktat tillsammans. Spawnpunkternas egna tabeller gäller fortfarande för huvudfamiljen; bifamiljer får spawna på alla punkter i området."
