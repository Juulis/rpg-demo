{
  "meta": {
    "version": "1.0",
    "rule": "Varje monstertyp har fast nivå och fasta stats (monsterfamiljer.json). Formlerna nedan är designverktyg för att räkna fram nya undertyper, inte runtime.",
    "hero_max_level": 30
  },
  "scaling": {
    "reference": "Basstats i monsterfamiljer.json och portal_by.json gäller vid monstrets ref_level. d = level − ref_level (kan vara negativ).",
    "hp": "hp(L) = round(hp_ref × 1,10^d)",
    "damage": "skada(L) = round(skada_ref × 1,07^d), min och max var för sig",
    "defense": "forsvar(L) = max(0, forsvar_ref + 0,4 × d)",
    "attack_rating": "AR(L) = 15 + 8 × L",
    "defense_rating": "DR(L) = 15 + 8 × L + forsvar(L) × 2",
    "xp": "xp(L) = round(xp_mult × 3 × L^1,5) där xp_mult = xp_ref / 10 (xp_ref är monstrets xp i datafilen)",
    "speed": "Fart skalas inte.",
    "note": "XP räknas från level, inte från d, så samma monster ger mer på högre nivå oavsett ref.",
    "hit_ref": "attribut.json hit_chance",
    "usage": "Designverktyg: används bara när en ny undertyp skapas. Resultatet skrivs in som fasta tal."
  },
  "boss_levels": {
    "grabjornen_ulvhild": 6,
